# pfSense UI Environment Variables
# Copy this file to .env.local or .env.development and adjust as needed.

# Base URL for the pfSense REST API v2.
# In development, use a relative path so the Vite proxy handles CORS.
# In production, set to the full URL of your pfSense appliance.
VITE_PFSENSE_API_URL=/api/v2

# Target for the Vite dev server proxy (only used in development).
# Set to your pfSense appliance address.
VITE_DEV_PROXY_TARGET=https://192.168.1.1

# Application title shown in the top bar and browser tab.
VITE_APP_TITLE=pfSense UI